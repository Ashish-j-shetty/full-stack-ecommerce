{
  "name": "ecom-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/config/migrate.ts",
    "seed": "tsx src/config/seed.ts",
    "lint": "eslint .",
    "test": "jest --runInBand --forceExit",
    "scaling:redis": "echo '[SCALING] Run: npm install ioredis && npm install -D @types/ioredis'",
    "test:unit": "jest --runInBand --forceExit --testPathPattern=__tests__/unit --coverage --coverageReporters=text-summary",
    "test:ci": "pnpm test:unit --coverageThreshold='{\"global\":{\"lines\":60,\"functions\":60,\"statements\":60,\"branches\":60}}'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.2"
  }
}
