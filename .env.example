# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ============================================================
# Database
# ============================================================
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ecom_db

# Full connection URLs (used by server and tests directly)
# In Docker Compose these are constructed from the parts above.
# For local (non-Docker) development, set them explicitly.
DATABASE_URL=postgres://ecom_user:change_me_strong_password@localhost:5432/ecom_db
TEST_DATABASE_URL=postgres://ecom_user:change_me_strong_password@localhost:5433/ecom_db_test

# ============================================================
# Server
# ============================================================
NODE_ENV=development          # set to "production" in prod
PORT=3001

# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_string

# ============================================================
# Client / CORS
# ============================================================
# URL the browser uses to reach the API (used by Vite / client build)
VITE_API_URL=http://localhost:3001

# URL of the frontend — used by the server for CORS in production
# Example production value: https://myshop.com
CLIENT_URL=http://localhost:5173

# ============================================================
# Redis (optional — disabled by default)
# ============================================================
# Uncomment and set ENABLE_REDIS=true in docker-compose.yml to enable
# REDIS_URL=redis://localhost:6379
